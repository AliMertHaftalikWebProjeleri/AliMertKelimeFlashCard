@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="text-center mt-5">
    <h1 class="display-4 fw-bold text-primary mb-4"><i class="fa-solid fa-graduation-cap"></i> Kelime Ezberleme Uygulamasına Hoş Geldiniz</h1>
    <p class="lead text-secondary">
        İstediğiniz dildeki kelimeleri hızlı ve etkili şekilde öğrenmek için hemen kayıt olun ve flashcard eğitimine başlayın!
    </p>
    <div class="mt-5">
        <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg me-3 px-5 py-3 shadow-sm">Ücretsiz Kayıt Ol</a>
        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-lg px-5 py-3 shadow-sm">Sisteme Giriş Yap</a>
    </div>
</div>

<div class="row mt-5 pt-5">
    <div class="col-md-4 text-center">
        <div class="p-4 border rounded shadow-sm bg-white">
            <h3 class="text-primary"><i class="fa-solid fa-language"></i></h3>
            <h5 class="fw-bold mt-3">Dilini Seç</h5>
            <p class="text-muted">Geniş yelpazede dillerden birini seçerek öğrenimini kişiselleştir.</p>
        </div>
    </div>
    <div class="col-md-4 text-center">
        <div class="p-4 border rounded shadow-sm bg-white">
            <h3 class="text-primary"><i class="fa-solid fa-layer-group"></i></h3>
            <h5 class="fw-bold mt-3">Kartlarla Çalış</h5>
            <p class="text-muted">Etkileşimli Flashcard serisi ile ezberleme pratiği yap.</p>
        </div>
    </div>
    <div class="col-md-4 text-center">
        <div class="p-4 border rounded shadow-sm bg-white">
            <h3 class="text-primary"><i class="fa-solid fa-medal"></i></h3>
            <h5 class="fw-bold mt-3">Gelişimini Artır</h5>
            <p class="text-muted">Kısa sürede daha fazla kelime ezberle ve kendini test et.</p>
        </div>
    </div>
</div>
